 BOOL CGameRules::CanHavePlayerItem( CBasePlayer *pPlayer, CBasePlayerItem *pWeapon )
 {
+	// Archipelago: refuse a weapon the multiworld has not sent. Every path
+	// into the inventory asks this, including GiveNamedItem from map logic.
+	if ( !ap::CanCollect( pPlayer, pWeapon ) )
+		return FALSE;
+
 	// only living players can have items
 	if ( pPlayer->pev->deadflag != DEAD_NO )
 		return FALSE;
