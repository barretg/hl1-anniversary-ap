+// AP: Opposing Force's night vision overlay, from halflife-op4-updated
+void CHudFlashlight::DrawNightVision( void )
+{
+	static int lastFrame = 0;
+
+	if ( !m_nvSprite )
+		return;
+
+	int frames = SPR_Frames( m_nvSprite );
+	int frameIndex = rand() % frames;
+
+	if ( frames > 1 && frameIndex == lastFrame )
+		frameIndex = ( frameIndex + 1 ) % frames;
+
+	lastFrame = frameIndex;
+
+	const int width = SPR_Width( m_nvSprite, 0 );
+	const int height = SPR_Height( m_nvSprite, 0 );
+
+	SPR_Set( m_nvSprite, 0, 170, 0 );
+
+	wrect_t rc;
+
+	for ( int x = 0; x < ScreenWidth; x += width )
+	{
+		rc.left = 0;
+		rc.right = x + width >= ScreenWidth ? ScreenWidth - x : width;
+
+		for ( int y = 0; y < ScreenHeight; y += height )
+		{
+			rc.top = 0;
+			rc.bottom = y + height >= ScreenHeight ? ScreenHeight - y : height;
+
+			SPR_DrawAdditive( frameIndex, x, y, &rc );
+		}
+	}
+}
