// load the base configuration
//exec default.cfg

s_refgain 0.4
s_refdelay 4
s_occfactor 0.25
s_verbwet 0.25
s_distance 60


// load the language configuration
exec language.cfg

// Setup custom controller
exec joystick.cfg
exec controller.cfg

// run a user script file if present
exec autoexec.cfg

// Archipelago: the !menu keys (see apmenu.cfg). After autoexec so they hold.
exec apmenu.cfg

//
// stuff command line statements
//
stuffcmds

